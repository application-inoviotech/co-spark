APP_NAME="COSPARK Insurance Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cospark.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cospark
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Production: database, with a queue worker running (php artisan queue:work) so emails and texts send in the background
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Live notifications (member dashboard + producer portal): create a Channels app at pusher.com,
# fill the PUSHER_* keys below and set BROADCAST_DRIVER=pusher. With BROADCAST_DRIVER=log nothing is pushed.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

APP_TIMEZONE=America/Detroit





# Testing only: every OTP is this code. Remove before going live.
OTP_FIXED_CODE=123456
ASSET_VERSION=2

# Public social destinations. Unconfigured links are hidden.
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=

# Card payments (Authorize.net). Login ID + Transaction Key: Account → Security Settings → API Credentials & Keys.
# Public Client Key (for Accept.js in the browser): Account → Security Settings → Manage Public Client Key.
# AUTHORIZENET_ENV=sandbox for testing, production for live payments. Card entry needs HTTPS.
AUTHORIZENET_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
AUTHORIZENET_CLIENT_KEY=
AUTHORIZENET_ENV=sandbox
# Webhooks: Signature Key from the same sandbox/production merchant account (128 hex characters).
AUTHORIZENET_SIGNATURE_KEY=

# Emails and text messages (Klaviyo). Private API Key: Settings → API Keys (scopes: Events write, Subscriptions write, Lists read).
# Klaviyo flows on the "COSPARK Email" and "COSPARK SMS" metrics send the messages. Leave empty to use MAIL_* (and log SMS).
KLAVIYO_PRIVATE_KEY=
KLAVIYO_SMS_LIST_ID=
KLAVIYO_API_REVISION=2025-10-15
